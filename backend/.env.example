# Copy to .env and fill in. NEVER commit .env.

# --- Twilio ---------------------------------------------------------------
# Console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Used ONLY to validate inbound webhook signatures. Never sent to the browser.
TWILIO_AUTH_TOKEN=
# Console -> Account -> API keys & tokens -> Create API key (Standard)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=
# Voice -> TwiML -> TwiML Apps. Its Voice URL must point at
#   <BACKEND_PUBLIC_URL>/api/call/twiml/A
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Caller ID for the PSTN leg. MUST be a non-Indian number (design doc §14).
TWILIO_PHONE_NUMBER=+17372508034

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=

# Which translation backend to use.
#   translate = gpt-realtime-translate. Purpose-built; starts translating while
#               the speaker is still talking, so latency is much lower. Billed
#               per audio-minute. Tamil output works but is NOT documented by
#               OpenAI, so it could change without notice.
#   realtime  = gpt-realtime-2.1. Conversational model kept to interpreting by
#               its prompt. Tamil is officially supported. Billed per token.
# Switch modes with one restart; both are fully supported and tested.
OPENAI_TRANSLATE_MODE=translate

OPENAI_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# --- URLs -----------------------------------------------------------------
# Your public HTTPS tunnel, e.g. https://abc123.ngrok-free.app
# Twilio cannot reach localhost. Update this every time ngrok restarts.
BACKEND_PUBLIC_URL=
FRONTEND_URL=http://localhost:5173

# --- Behaviour ------------------------------------------------------------
# true  = browser <-> browser, no PSTN call, no telephony spend
# false = leg B is dialled to a real phone number
DEMO_MODE=true
# Milestone 2 only: route each leg's audio back to itself. Use headphones.
ECHO_MODE=false
# Leave true. Only turn off for local tests that cannot sign requests.
VALIDATE_TWILIO_SIGNATURE=true
LOG_LEVEL=INFO
